# Salin ke .env (jangan commit). Tidak ada nilai rahasia di berkas ini.

# ---- Build frontend (Cloudflare "Build variables") ----
# Hanya nilai PUBLIK. anon key aman terlihat; service_role TIDAK BOLEH di sini.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# ---- Hanya untuk skrip lokal / CI staging / worker OMR (bukan frontend) ----
# Ambil dari tim Supabase lewat jalur aman, jangan ditempel di chat atau repo.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Edge Function / worker (set lewat `supabase secrets set` atau secret platform, bukan file ini) ----
# UPLOAD_MAX_BYTES=
# UPLOAD_ALLOWED_TYPES=application/pdf,image/jpeg,image/png

# ---- Akun uji E2E (staging saja; sandi di-generate, bukan sandi asli) ----
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
TEST_TEACHER_EMAIL=
TEST_TEACHER_PASSWORD=
