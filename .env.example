# Salin ke .env (jangan commit). Berkas ini tidak berisi nilai rahasia.

# Nilai PUBLIK untuk aplikasi klien. anon key aman terlihat; service_role TIDAK BOLEH ada di klien.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Hanya untuk skrip server/CI. Jangan tempel di chat atau repo.
SUPABASE_SERVICE_ROLE_KEY=
